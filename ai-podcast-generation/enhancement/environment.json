{
  "project_id": "ai-podcast-generation",
  "manifests": [
    "pyproject.toml"
  ],
  "requirements": [
    "crewai>=0.193.2",
    "firecrawl-py>=4.3.6",
    "kokoro>=0.9.4",
    "numpy>=1.24.0",
    "python-dotenv>=1.1.1",
    "soundfile>=0.12.1",
    "streamlit>=1.28.0"
  ],
  "python_requirements": [
    ">=3.11,<3.13"
  ],
  "environment_names": [
    "HF_HOME",
    "KOKORO_REPO_ID",
    "OPENAI_API_KEY",
    "PODCAST_CACHE_DIR"
  ],
  "scope": "declared Python dependency presence only; optional/dev/alternate paths may be included; Node manifests are listed, not resolved"
}
